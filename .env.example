# ArrivalGuard. Copy to .env.local and fill in. Never commit real values.
# Local development uses the Neon "dev" branch. Production values live only in Vercel.

# Neon: pooled connection string (host contains -pooler) for the app
DATABASE_URL=
# Neon: direct connection string for migrations
DATABASE_URL_UNPOOLED=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sessions: random 256-bit pepper, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_PEPPER=
# Evaluation access code for the jury (8 characters or more)
EVAL_ACCESS_CODE=
# Evaluation session lifetime in hours (14 days)
EVAL_SESSION_TTL_HOURS=336

# AI budgets in USD
AI_BUDGET_PER_WORKSPACE_USD=3.00
AI_BUDGET_DAILY_USD=15.00

# Model prices in USD per million tokens (see docs/DECISIONS.md for source and date)
PRICE_INPUT_PER_MTOK_USD=2.00
PRICE_OUTPUT_PER_MTOK_USD=10.00
PRICE_CACHE_READ_PER_MTOK_USD=0.10
PRICE_CACHE_WRITE_PER_MTOK_USD=2.50

# Public base URL of the app
APP_BASE_URL=http://localhost:3000
